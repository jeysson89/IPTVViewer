<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>IPTVViewer</RootNamespace>
    <AssemblyName>IPTVViewer</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>IPTV Newline</Product>
    <AssemblyTitle>IPTV Newline</AssemblyTitle>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>0.0.9</Version>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.4" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="IPTVViewer.app.ico" />
    <EmbeddedResource Include="Resources\logo.png" Condition="Exists('Resources\logo.png')" />
  </ItemGroup>

  <!-- Р•РґРёРЅС‹Р№ exe: VLC СѓРїР°РєРѕРІС‹РІР°РµС‚СЃСЏ РІРЅСѓС‚СЂСЊ Рё СЂР°СЃРїР°РєРѕРІС‹РІР°РµС‚СЃСЏ РїСЂРё РїРµСЂРІРѕРј Р·Р°РїСѓСЃРєРµ. -->
  <ItemGroup Condition="Exists('vlc-data\vlc-x64.zip') And Exists('vlc-data\vlc-x86.zip')">
    <EmbeddedResource Include="vlc-data\vlc-x64.zip" LogicalName="IPTVViewer.vlc-x64.zip" />
    <EmbeddedResource Include="vlc-data\vlc-x86.zip" LogicalName="IPTVViewer.vlc-x86.zip" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!-- Р•РґРёРЅС‹Р№ exe: СѓРїСЂР°РІР»СЏРµРјС‹Рµ Р·Р°РІРёСЃРёРјРѕСЃС‚Рё РІСЃС‚СЂРѕРµРЅС‹ Рё Р·Р°РіСЂСѓР¶Р°СЋС‚СЃСЏ РёР· РїР°РјСЏС‚Рё. -->
  <ItemGroup>
    <ManagedDep Include="LibVLCSharp" DepDir="libvlcsharp\3.9.4\lib\net471" />
    <ManagedDep Include="LibVLCSharp.WinForms" DepDir="libvlcsharp.winforms\3.9.4\lib\net40" />
    <ManagedDep Include="System.Buffers" DepDir="system.buffers\4.6.0\lib\net462" />
    <ManagedDep Include="System.Memory" DepDir="system.memory\4.6.0\lib\net462" />
    <ManagedDep Include="System.Numerics.Vectors" DepDir="system.numerics.vectors\4.6.0\lib\net462" />
    <ManagedDep Include="System.Runtime.CompilerServices.Unsafe" DepDir="system.runtime.compilerservices.unsafe\6.1.0\lib\net462" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="@(ManagedDep->'$(USERPROFILE)\.nuget\packages\%(DepDir)\%(Identity).dll')"
                      LogicalName="IPTVViewer.deps.%(Filename).dll" />
  </ItemGroup>
</Project>
