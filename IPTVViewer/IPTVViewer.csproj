<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Самодостаточная сборка (win-x86): рантайм .NET вшит в exe, программа
      запускается на любом Windows от 7 SP1 (32- и 64-бит) БЕЗ установки
      NET Framework или чего-либо ещё. x86 работает и на 64-битных системах.
    -->
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>IPTVViewer</RootNamespace>
    <AssemblyName>IPTVViewer</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>IPTV Newline</Product>
    <AssemblyTitle>IPTV Newline</AssemblyTitle>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>0.0.12</Version>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <!-- Командный билд из bin может работать на рантайме новее net6
         (на dev-машине 8/10), публикация всегда самодостаточная. -->
    <RollForward>LatestMajor</RollForward>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.9.4" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.4" />
    <!-- Нативные файлы VLC не нужны в выводе: движок вшит в exe и
         распаковывается в LocalAppData при первом запуске (VlcLocator). -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="IPTVViewer.app.ico" />
    <EmbeddedResource Include="Resources\logo.png" Condition="Exists('Resources\logo.png')" />
  </ItemGroup>

  <!-- Движок VLC пакуется внутрь exe и распаковывается при первом запуске. -->
  <ItemGroup Condition="Exists('vlc-data\vlc-x64.zip') And Exists('vlc-data\vlc-x86.zip')">
    <EmbeddedResource Include="vlc-data\vlc-x64.zip" LogicalName="IPTVViewer.vlc-x64.zip" />
    <EmbeddedResource Include="vlc-data\vlc-x86.zip" LogicalName="IPTVViewer.vlc-x86.zip" />
  </ItemGroup>
</Project>
